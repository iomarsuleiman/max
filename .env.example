# Leave these empty to run Max in local mode (private workspace stored in .max-data/).
# Fill them for cloud mode; see docs/SETUP.md.
NEXT_PUBLIC_APP_URL=https://max.chaos.fail
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Same value in the Convex dashboard and the web app (openssl rand -base64 48).
MAX_SERVER_SECRET=
# Direct Notion import: configure these on the Convex deployment, not in public variables.
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
# NOTION_REDIRECT_URI=https://max.chaos.fail/api/notion/callback
# NOTION_TOKEN_ENCRYPTION_KEY= (64 hexadecimal characters, independently generated)
# Self-hosting a production build without Clerk/Convex:
# MAX_LOCAL_MODE=true
# MAX_DATA_DIR=.max-data
