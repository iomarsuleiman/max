{
  "name": "max",
  "version": "1.0.0",
  "private": true,
  "description": "A calm, private workspace for notes, nested pages and personal databases.",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p convex",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:backup": "node --test tests/backup/local-backup.test.mjs",
    "test:cloud-recovery": "node --test tests/cloud-recovery/snapshot.test.mjs",
    "backup:local": "node scripts/local-backup.mjs",
    "migration:rehearse": "tsx scripts/workspace-rehearsal.mjs",
    "measure:baseline": "node scripts/measure-baseline.mjs",
    "proof:outbox": "node scripts/outbox-spike.mjs",
    "proof:convex-local": "node scripts/verify-convex-local.mjs",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:backup && pnpm test:cloud-recovery",
    "mcp:docs": "tsx scripts/mcp-inventory.ts",
    "emoji:build": "node scripts/build-emoji-data.mjs",
    "covers:fetch": "node scripts/fetch-covers.mjs && node scripts/cover-colors.mjs"
  },
  "dependencies": {
    "@blocknote/code-block": "0.55.0",
    "@blocknote/core": "0.55.0",
    "@blocknote/react": "0.55.0",
    "@blocknote/shadcn": "0.55.0",
    "@blocknote/xl-multi-column": "0.55.0",
    "@clerk/nextjs": "^7.9.25",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@shikijs/core": "4.6.0",
    "@shikijs/engine-javascript": "4.6.0",
    "@shikijs/langs-precompiled": "4.6.0",
    "@shikijs/themes": "4.6.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.49.0",
    "d3-force": "3.0.0",
    "emojibase-data": "^18.0.0",
    "fflate": "^0.8.3",
    "katex": "^0.19.1",
    "lucide-react": "^1.70.0",
    "mermaid": "12.1.0",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "qrcode-generator": "^2.0.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "turndown": "^7.2.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/d3-force": "3.0.10",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "convex-test": "^0.0.69",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.5",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "homepage": "https://max.chaos.fail",
  "repository": {
    "type": "git",
    "url": "https://github.com/iomarsuleiman/max"
  }
}
